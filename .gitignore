__pycache__/
*.pyc
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/

# diagnostic output written by hls-sniffer --json (including plain "diag.json")
*.diag.json
diag.json
out.mp4

# PyInstaller auto-generates these next to the repo root on every local
# build; packaging/build.py doesn't rely on them being checked in
*.spec

# generated by packaging/assets/generate_icon.py from hls_sniffer.png — that
# source file is the only icon asset that's actually committed
packaging/assets/icon.ico
packaging/assets/icon.icns
packaging/assets/icon.png
packaging/assets/icon_256.png
packaging/assets/hicolor/
